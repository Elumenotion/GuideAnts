{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "vite/client",
      "node"
    ],
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES6"
    ]
  },
  "exclude": [
    "node_modules",
    "dist",
    "dist-browser",
    "electron",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ]
}
