  "components": {
    "schemas": {
      "AppToolResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok", "error"]
          },
          "action": {
            "type": "string"
          },
          "message": {
            "type": "string",
            "description": "Error detail when status is error; surfaced verbatim from the API."
          },
          "httpStatus": {
            "type": "integer"
          },
          "data": {
            "description": "Result payload (context snapshot, list of projects/notebooks/conversations, or the created/updated entity)."
          },
          "navigatedTo": {
            "type": "string",
            "description": "The client route navigated to, when the tool changed the current screen."
          }
        },
        "required": ["status", "action"]
      },
      "AppProjectRef": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "description": "Defaults to the current project from context when omitted.",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "AppNotebookRef": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "description": "Defaults to the current project from context when omitted.",
            "format": "uuid"
          },
          "notebookId": {
            "type": "string",
            "description": "Defaults to the current notebook from context when omitted.",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "AppCreateProjectRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": ["title"],
        "additionalProperties": false
      },
      "AppRenameProjectRequest": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "description": "Defaults to the current project from context when omitted.",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": ["title"],
        "additionalProperties": false
      },
      "AppCreateNotebookRequest": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "description": "Defaults to the current project from context when omitted.",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "guideId": {
            "type": "string",
            "description": "Optional guide to attach to the new notebook.",
            "format": "uuid"
          },
          "navigate": {
            "type": "boolean",
            "description": "When false, create without navigating to the new notebook. Defaults to true."
          }
        },
        "required": ["title"],
        "additionalProperties": false
      },
      "AppRenameNotebookRequest": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "description": "Defaults to the current project from context when omitted.",
            "format": "uuid"
          },
          "notebookId": {
            "type": "string",
            "description": "Defaults to the current notebook from context when omitted.",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": ["title"],
        "additionalProperties": false
      },
      "AppCreateConversationRequest": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "description": "Defaults to the current project from context when omitted.",
            "format": "uuid"
          },
          "notebookId": {
            "type": "string",
            "description": "Defaults to the current notebook from context when omitted.",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          }
        },
        "required": ["title"],
        "additionalProperties": false
      },
      "AppRenameConversationRequest": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "description": "Defaults to the current project from context when omitted.",
            "format": "uuid"
          },
          "notebookId": {
            "type": "string",
            "description": "Defaults to the current notebook from context when omitted.",
            "format": "uuid"
          },
          "conversationId": {
            "type": "string",
            "description": "Defaults to the active conversation from context when omitted.",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          }
        },
        "required": ["title"],
        "additionalProperties": false
      }
    }
  }
