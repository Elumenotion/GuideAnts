  "paths": {
    "GuideAntsApp.AppGetCurrentContext": {
      "post": {
        "operationId": "AppGetCurrentContext",
        "summary": "Return the current client view context (route, role, current project/notebook ids and titles, selected item, active conversation). Use this to resolve phrases like 'this notebook' before acting.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppToolResponse"
                }
              }
            }
          }
        }
      }
    },
