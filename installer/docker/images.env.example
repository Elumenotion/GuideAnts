# Example release pin file. Release packaging generates installer/docker/images.env
# with immutable digests for the published tag. Dev checkouts usually omit this file
# and use compose fragment defaults (:main).
#
# GA_RELEASE_TAG=v0.0.0
# GA_UPDATE_CHANNEL=main
#
# GA_WEBAPI_UI_MSSQL_GHCR_IMAGE=ghcr.io/elumenotion/guideants-webapi-ui-mssql@sha256:...
# GA_WEBAPI_UI_SLIM_GHCR_IMAGE=ghcr.io/elumenotion/guideants-webapi-ui-slim@sha256:...
# GA_MSSQL_IMAGE=ghcr.io/elumenotion/mssql2025-express-fts@sha256:...
# GA_AI_SLIM_GHCR_IMAGE=ghcr.io/elumenotion/guideants-ai-slim@sha256:...
# GA_AI_CPU_GHCR_IMAGE=ghcr.io/elumenotion/guideants-ai-cpu@sha256:...
# GA_AI_CUDA_GHCR_IMAGE=ghcr.io/elumenotion/guideants-ai-cuda13@sha256:...
# GA_AI_ROCM_GHCR_IMAGE=ghcr.io/elumenotion/guideants-ai-rocm@sha256:...
# GA_AI_VULKAN_GHCR_IMAGE=ghcr.io/elumenotion/guideants-ai-vulkan@sha256:...
# GA_PLANTUML_GHCR_IMAGE=ghcr.io/elumenotion/guideants-plantuml@sha256:...
# GA_SEARXNG_GHCR_IMAGE=ghcr.io/elumenotion/guideants-searxng@sha256:...
