# Use Eclipse Temurin (recommended replacement for deprecated OpenJDK images)
# Using the standard 11-jre tag which is actively maintained
FROM eclipse-temurin:11-jre AS base 

# Set the working directory
WORKDIR /app

# Install dependencies (GraphViz and .NET runtime)
RUN apt-get update && \
    apt-get install -y graphviz wget util-linux passwd bash && \
    rm -rf /var/lib/apt/lists/*

# Create a directory for PlantUML in /usr/local/lib
RUN mkdir -p /usr/local/lib/plantuml

# Download the PlantUML jar file to /usr/local/lib/plantuml
RUN wget https://github.com/plantuml/plantuml/releases/download/v1.2025.10/plantuml-1.2025.10.jar -O /usr/local/lib/plantuml/plantuml.jar --no-check-certificate

# Verify the jar file
RUN ls -l /usr/local/lib/plantuml/plantuml.jar

# Create a symbolic link or script to run PlantUML
RUN echo '#!/bin/sh\nexec java -jar /usr/local/lib/plantuml/plantuml.jar "$@"' > /usr/local/bin/plantuml && \
    chmod +x /usr/local/bin/plantuml

# Install .NET 8 ASP.NET Core runtime (portable install to avoid distro feed mismatch)
RUN wget https://dot.net/v1/dotnet-install.sh -O /tmp/dotnet-install.sh && \
    chmod +x /tmp/dotnet-install.sh && \
    /tmp/dotnet-install.sh --channel 8.0 --runtime aspnetcore --install-dir /usr/share/dotnet && \
    ln -sf /usr/share/dotnet/dotnet /usr/bin/dotnet && \
    rm /tmp/dotnet-install.sh

# Copy the pre-built ScriptExecutionAgent publish output
COPY ScriptExecutionAgent/ /app/script-agent/

# Expose the agent's port
EXPOSE 80

# Set the URL to listen on port 80
ENV ASPNETCORE_URLS=http://+:80

# The agent manages per-project users and drops privileges per-request

# Start the ScriptExecutionAgent
CMD ["dotnet", "/app/script-agent/ScriptExecutionAgent.dll"]
