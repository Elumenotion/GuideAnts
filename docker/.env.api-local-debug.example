# Example env for local debugging when GuideAnts API runs outside Docker.
# Usage:
#   docker compose --env-file docker/.env.api-local-debug.example -f docker/docker-compose.cuda.yml up -d --build
#
# IMPORTANT:
# - For local API at http://localhost:5106, set DocumentServer:ApiBaseUrl in the API
#   appsettings.Development.json to http://host.docker.internal:5106
# - JWT for the Document Server integration is configurable but off by default.

GA_WEBAPI_UI_IMAGE=guideants-webapi-ui:latest
DOCLING_SERVE_MAX_SYNC_WAIT=600
GA_CONTENT_FILES_HOST_PATH=D:/repos/GuideAnts/docker/volumes/content-files
GA_SEARXNG_CONFIG_HOST_PATH=./volumes/searxng/config
GA_SEARXNG_DATA_HOST_PATH=./volumes/searxng/data
GA_AI_CPU_IMAGE=guideants-ai:cpu-latest
GA_AI_CUDA_IMAGE=guideants-ai:cuda13-latest
GA_AI_ROCM_IMAGE=guideants-ai:rocm-latest
GA_AI_SLIM_IMAGE=guideants-ai:slim-latest
GA_DOCUMENTSERVER_IMAGE=ghcr.io/euro-office/documentserver:latest

# Host-specific global GPU ordering for CUDA workloads inside guideants-ai/docling containers.
CUDA_VISIBLE_DEVICES=1,0
# Optional service-specific overrides. Empty values inherit global ordering.
GA_LLAMA_CUDA_VISIBLE_DEVICES=
GA_ASR_CUDA_VISIBLE_DEVICES=1
GA_TTS_CUDA_VISIBLE_DEVICES=0
GA_EMB_CUDA_VISIBLE_DEVICES=1
GA_SD_CUDA_VISIBLE_DEVICES=0

GA_EMB_DEFAULT_MODEL_PATH=qwen3_embedding_0_6b
GA_EMB_WARMUP_ON_LOAD=1
# LlamaCpp HTTP client timeout (seconds) for guideants-webapi-ui chat completions.
GA_LLAMA_CPP_TIMEOUT_SECONDS=600
GA_DB_NAME=guideants
GA_SCRIPT_AGENT_TOKEN=dev-script-agent-token

GA_DOCUMENTSERVER_ENABLED=true
GA_DOCUMENTSERVER_PUBLIC_URL=http://localhost:8082
GA_DOCUMENTSERVER_JWT_ENABLED=false
# Optional when GA_DOCUMENTSERVER_JWT_ENABLED=true
# DOCUMENTSERVER_JWT_SECRET=<set-shared-secret>
# GA_DOCUMENTSERVER_JWT_HEADER=Authorization
# GA_DOCUMENTSERVER_JWT_IN_BODY=false
