{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{INPUT_IMAGE}}"
    }
  },
  "2": {
    "class_type": "LoadAudio",
    "inputs": {
      "audio": "{{INPUT_AUDIO}}"
    }
  },
  "3": {
    "class_type": "WanVideoVAELoader",
    "inputs": {
      "model_name": "Wan2_1_VAE_bf16.safetensors",
      "precision": "bf16",
      "use_cpu_cache": false,
      "verbose": false
    }
  },
  "4": {
    "class_type": "CLIPVisionLoader",
    "inputs": {
      "clip_name": "clip_vision_h.safetensors"
    }
  },
  "5": {
    "class_type": "WanVideoClipVisionEncode",
    "inputs": {
      "clip_vision": ["4", 0],
      "image_1": ["1", 0],
      "strength_1": 1.0,
      "strength_2": 1.0,
      "crop": "center",
      "combine_embeds": "average",
      "force_offload": false,
      "tiles": 0,
      "ratio": 0.5
    }
  },
  "6": {
    "class_type": "Wav2VecModelLoader",
    "inputs": {
      "model": "wav2vec2-chinese-base_fp16.safetensors",
      "base_precision": "fp16",
      "load_device": "main_device"
    }
  },
  "7": {
    "class_type": "MultiTalkWav2VecEmbeds",
    "inputs": {
      "wav2vec_model": ["6", 0],
      "audio_1": ["2", 0],
      "normalize_loudness": true,
      "num_frames": "{{FRAMES}}",
      "fps": "{{FPS}}",
      "audio_scale": 1.0,
      "audio_cfg_scale": 0.88,
      "multi_audio_type": "para",
      "add_noise_floor": false,
      "smooth_transients": true
    }
  },
  "8": {
    "class_type": "MultiTalkModelLoader",
    "inputs": {
      "model": "WanVideo/InfiniteTalk/Wan2_1-InfiniTetalk-Single_fp16.safetensors"
    }
  },
  "9": {
    "class_type": "WanVideoLoraSelect",
    "inputs": {
      "lora": "WanVideo/lightx2v_I2V_14B_480p_cfg_step_distill_rank32_bf16.safetensors",
      "strength": 1.0,
      "low_mem_load": false,
      "merge_loras": true
    }
  },
  "10": {
    "class_type": "WanVideoBlockSwap",
    "inputs": {
      "blocks_to_swap": 0,
      "offload_img_emb": false,
      "offload_txt_emb": false,
      "use_non_blocking": true,
      "vace_blocks_to_swap": 0,
      "prefetch_blocks": 0,
      "block_swap_debug": false
    }
  },
  "11": {
    "class_type": "WanVideoModelLoader",
    "inputs": {
      "model": "WanVideo/Wan2_1-I2V-14B-480P_fp8_e4m3fn.safetensors",
      "base_precision": "bf16",
      "quantization": "fp8_e4m3fn",
      "load_device": "main_device",
      "attention_mode": "sdpa",
      "block_swap_args": ["10", 0],
      "lora": ["9", 0],
      "multitalk_model": ["8", 0],
      "rms_norm_function": "default"
    }
  },
  "12": {
    "class_type": "WanVideoTextEncodeCached",
    "inputs": {
      "model_name": "umt5-xxl-enc-bf16.safetensors",
      "precision": "bf16",
      "positive_prompt": "A man telling a story | A man telling a story | A man telling a story | A man telling a story",
      "negative_prompt": "blur, distortion, extra limbs, deformed face, subtitles, low quality, static frame, exaggerated expression, head bobbing, dramatic gestures, overacting, wild motion",
      "quantization": "disabled",
      "use_disk_cache": true,
      "device": "gpu"
    }
  },
  "13": {
    "class_type": "WanVideoImageToVideoMultiTalk",
    "inputs": {
      "vae": ["3", 0],
      "width": "{{WIDTH}}",
      "height": "{{HEIGHT}}",
      "frame_window_size": 81,
      "motion_frame": 9,
      "force_offload": false,
      "colormatch": "disabled",
      "start_image": ["1", 0],
      "tiled_vae": false,
      "clip_embeds": ["5", 0],
      "mode": "infinitetalk",
      "output_path": ""
    }
  },
  "14": {
    "class_type": "WanVideoSampler",
    "inputs": {
      "model": ["11", 0],
      "image_embeds": ["13", 0],
      "steps": "{{STEPS}}",
      "cfg": "{{CFG}}",
      "shift": 8.0,
      "seed": "{{SEED}}",
      "force_offload": false,
      "scheduler": "dpm++_sde",
      "riflex_freq_index": 0,
      "text_embeds": ["12", 0],
      "denoise_strength": 1.0,
      "batched_cfg": false,
      "rope_function": "comfy",
      "start_step": 0,
      "end_step": -1,
      "add_noise_to_samples": true,
      "multitalk_embeds": ["7", 0]
    }
  },
  "15": {
    "class_type": "WanVideoPassImagesFromSamples",
    "inputs": {
      "samples": ["14", 0]
    }
  },
  "16": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": ["15", 0],
      "audio": ["7", 1],
      "frame_rate": "{{FPS}}",
      "loop_count": 0,
      "filename_prefix": "infinitetalk",
      "format": "video/h264-mp4",
      "pix_fmt": "yuv420p",
      "crf": 19,
      "save_metadata": true,
      "trim_to_audio": true,
      "pingpong": false,
      "save_output": true
    }
  }
}
