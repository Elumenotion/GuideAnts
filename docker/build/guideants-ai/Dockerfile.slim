# syntax=docker/dockerfile:1.7-labs

# =============================================================================
# Slim backend (no stable-diffusion, ASR, TTS, EMB, or Playwright)
# =============================================================================
ARG GA_DEPS_SLIM_IMAGE=deps-slim
ARG GA_UBUNTU_MIRROR_URL=http://mirrors.kernel.org/ubuntu
ARG PYTHON311_VERSION=3.11.11

FROM python:${PYTHON311_VERSION}-slim-bookworm AS python311-runtime
ARG PYTHON311_VERSION

# =============================================================================
# Slim backend (runtime base + python deps builder + dependency image)
# =============================================================================
FROM ghcr.io/ggml-org/llama.cpp:server AS runtime-cpu-base
ARG GA_UBUNTU_MIRROR_URL
ENV DEBIAN_FRONTEND=noninteractive
RUN if [ -f /etc/apt/sources.list.d/ubuntu.sources ]; then \
        sed -i \
            -e "s|http://archive.ubuntu.com/ubuntu|${GA_UBUNTU_MIRROR_URL}|g" \
            -e "s|http://security.ubuntu.com/ubuntu|${GA_UBUNTU_MIRROR_URL}|g" \
            /etc/apt/sources.list.d/ubuntu.sources; \
    fi \
    && if [ -f /etc/apt/sources.list ]; then \
        sed -i \
            -e "s|http://archive.ubuntu.com/ubuntu|${GA_UBUNTU_MIRROR_URL}|g" \
            -e "s|http://security.ubuntu.com/ubuntu|${GA_UBUNTU_MIRROR_URL}|g" \
            /etc/apt/sources.list; \
    fi

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl \
        libbz2-1.0 libffi8 libgdbm6 liblzma5 libncursesw6 \
        libreadline8 libsqlite3-0 libssl3 zlib1g libuuid1 tk \
    && rm -rf /var/lib/apt/lists/*
COPY --from=python311-runtime /usr/local/bin/python3.11 /usr/local/bin/python3.11
COPY --from=python311-runtime /usr/local/bin/pip3.11 /usr/local/bin/pip3.11
COPY --from=python311-runtime /usr/local/lib/python3.11 /usr/local/lib/python3.11
COPY --from=python311-runtime /usr/local/lib/libpython3.11.so.1.0 /usr/local/lib/libpython3.11.so.1.0
COPY --from=python311-runtime /usr/local/include/python3.11 /usr/local/include/python3.11
RUN ln -sf /usr/local/bin/python3.11 /usr/local/bin/python3 \
    && ln -sf /usr/local/bin/pip3.11 /usr/local/bin/pip3 \
    && echo "/usr/local/lib" > /etc/ld.so.conf.d/python311.conf \
    && ldconfig

RUN curl -fsSL https://dot.net/v1/dotnet-install.sh -o /tmp/dotnet-install.sh \
    && chmod +x /tmp/dotnet-install.sh \
    && /tmp/dotnet-install.sh --channel 8.0 --runtime aspnetcore --install-dir /usr/share/dotnet \
    && ln -sf /usr/share/dotnet/dotnet /usr/bin/dotnet \
    && rm /tmp/dotnet-install.sh
ENV DOTNET_ROOT=/usr/share/dotnet

ARG PWSH_VERSION=7.4.7
RUN curl -sSL "https://github.com/PowerShell/PowerShell/releases/download/v${PWSH_VERSION}/powershell-${PWSH_VERSION}-linux-x64.tar.gz" \
        -o /tmp/pwsh.tar.gz \
    && mkdir -p /opt/microsoft/powershell/${PWSH_VERSION} \
    && tar zxf /tmp/pwsh.tar.gz -C /opt/microsoft/powershell/${PWSH_VERSION} \
    && ln -s /opt/microsoft/powershell/${PWSH_VERSION}/pwsh /usr/bin/pwsh \
    && chmod +x /usr/bin/pwsh \
    && rm /tmp/pwsh.tar.gz

ENV VIRTUAL_ENV=/opt/venv
ENV PATH="$VIRTUAL_ENV/bin:$PATH"
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PYTHONUNBUFFERED=1

FROM runtime-cpu-base AS pydeps-slim-builder
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential cmake git \
        graphviz-dev pkg-config \
        ffmpeg \
    && rm -rf /var/lib/apt/lists/*

RUN python3.11 -m venv $VIRTUAL_ENV

COPY requirements.txt /tmp/requirements.txt

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip "setuptools<82" wheel \
    && pip install -r /tmp/requirements.txt \
    && rm -f /tmp/requirements.txt

FROM runtime-cpu-base AS deps-slim
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends \
        graphviz ffmpeg bash sqlite3 nginx util-linux passwd \
    && rm -rf /var/lib/apt/lists/*

COPY --from=pydeps-slim-builder /opt/venv /opt/venv

FROM ${GA_DEPS_SLIM_IMAGE} AS final-slim

COPY ScriptExecutionAgent/ /app/script-agent/
COPY nginx.conf /etc/nginx/nginx.conf
COPY entrypoint.sh /entrypoint.sh
COPY start-llama.sh /app/start-llama.sh
COPY start-llama-admin.sh /app/start-llama-admin.sh
COPY start-media.sh /app/start-media.sh
COPY router-models.seed.ini /opt/seed/router-models.ini
RUN chmod +x /entrypoint.sh /app/start-llama.sh /app/start-llama-admin.sh /app/start-media.sh

COPY llama-admin-service/ /app/llama-admin-service/
COPY media-service/ /app/media-service/

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -fsS http://localhost/sandbox/health || curl -fsS http://localhost/llama-cpp/health || curl -fsS http://localhost/media/health || exit 1

ENTRYPOINT ["/entrypoint.sh"]
