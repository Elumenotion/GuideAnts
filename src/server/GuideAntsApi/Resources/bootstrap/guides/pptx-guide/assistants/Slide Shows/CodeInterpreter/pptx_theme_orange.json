{
  "theme": {
    "name": "Vibrant Orange Modern",
    "description": "Bright orange and teal theme with bold typography and modern spacing"
  },
  "typography": {
    "fonts": {
      "title": "Arial Black",
      "body": "Arial",
      "code": "Courier New"
    },
    "sizes": {
      "title": 56,
      "subtitle": 34,
      "body": 21,
      "bullet": 21,
      "code": 17,
      "caption": 17
    },
    "spacing": {
      "title_space_after": 14,
      "body_space_after": 7,
      "bullet_space_after": 9,
      "line_spacing": 1.25
    }
  },
  "colors": {
    "primary": [220, 53, 34],
    "secondary": [100, 100, 100],
    "accent": [0, 191, 165],
    "background": [255, 255, 255],
    "light_bg": [255, 243, 224],
    "code_bg": [240, 240, 240],
    "code_border": [220, 53, 34]
  },
  "layout": {
    "slide_dimensions": {
      "width": 13.33,
      "height": 7.5
    },
    "margins": {
      "top": 0.55,
      "bottom": 0.55,
      "left": 1.1,
      "right": 1.1
    },
    "spacing": {
      "title_to_content": 0.8,
      "paragraph_spacing": 0.28,
      "bullet_spacing": 0.18,
      "image_to_text": 0.55,
      "bullet_indent_base": 0.55
    },
    "image": {
      "max_width": 9.2,
      "max_height": 4.7,
      "default_max_height": 4.7
    }
  }
}

