  "paths": {
    "GuideAntsApp.AppEcho": {
      "post": {
        "operationId": "AppEcho",
        "summary": "Echo a message and optional context from the GuideAnts client (debug helper).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "Message to echo back."
                  },
                  "context": {
                    "type": "object",
                    "description": "Optional client context snapshot.",
                    "additionalProperties": true
                  }
                },
                "required": [
                  "message"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppEchoResponse"
                }
              }
            }
          }
        }
      }
    },
