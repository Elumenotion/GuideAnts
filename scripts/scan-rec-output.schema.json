{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "disposition_reason",
    "recommendation",
    "confidence",
    "tags"
  ],
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "valid",
        "reject"
      ]
    },
    "disposition_reason": {
      "type": "string",
      "minLength": 1
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "actions",
        "code_pointers",
        "references"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "code_pointers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "tags": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
