ARG BASE_IMAGE="dotnet-9.0-python-3.11:latest"
FROM ${BASE_IMAGE} AS base

WORKDIR /app
COPY requirements.txt .

RUN pip install --upgrade pip

# Install dependencies and Python 3.11 from the official repositories
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        graphviz \
        graphviz-dev \
        build-essential \
        cmake \
        libopenblas-dev \
        liblapack-dev \
        libboost-python-dev \
        python3-dev \
        util-linux \
        passwd \
        ffmpeg \
        bash && \
    rm -rf /var/lib/apt/lists/*

RUN pip install torch==2.3.1+cpu -f https://download.pytorch.org/whl/torch_stable.html && \
    pip install torchaudio==2.3.1+cpu -f https://download.pytorch.org/whl/torch_stable.html
    
RUN pip install --no-cache-dir -r requirements.txt

# Copy the pre-built ScriptExecutionAgent publish output
COPY ScriptExecutionAgent/publish/ /app/script-agent/

# Expose the agent's port
EXPOSE 80

# Set the URL to listen on port 80
ENV ASPNETCORE_URLS=http://+:80

# The agent manages per-project users and drops privileges per-request

# Start the ScriptExecutionAgent
CMD ["dotnet", "/app/script-agent/ScriptExecutionAgent.dll"]