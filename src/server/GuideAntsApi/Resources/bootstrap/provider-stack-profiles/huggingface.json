    {
      "serviceId": "SpeechSynthesis",
      "providerId": "SpeechSynthesis.HuggingFace.Inference",
      "modelId": "ResembleAI/chatterbox",
      "timeoutSeconds": 300
    }
  ],
  "runtimeDependencies": []
