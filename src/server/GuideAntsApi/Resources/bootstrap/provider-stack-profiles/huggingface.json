      "timeoutSeconds": 600
    },
    {
      "serviceId": "SpeechTranscription",
      "providerId": "SpeechTranscription.HuggingFace.Inference",
      "modelId": "openai/whisper-large-v3",
      "timeoutSeconds": 300
