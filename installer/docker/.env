# GuideAnts portable .env — clean template (no host-specific values).
# Content files are always stored in ./volumes/content-files.

GA_WEBAPI_UI_IMAGE=guideants-webapi-ui:latest
GA_AI_CPU_IMAGE=guideants-ai:cpu-latest
GA_AI_CUDA_IMAGE=guideants-ai:cuda13-latest
GA_AI_ROCM_IMAGE=guideants-ai:rocm-latest
GA_AI_SLIM_IMAGE=guideants-ai:slim-latest
GA_AI_VULKAN_IMAGE=guideants-ai:vulkan-latest
GGML_VK_VISIBLE_DEVICES=1
DOCLING_SERVE_MAX_SYNC_WAIT=600

GA_CONTENT_FILES_HOST_PATH=./volumes/content-files

GA_SEARXNG_CONFIG_HOST_PATH=./volumes/searxng/config
GA_SEARXNG_DATA_HOST_PATH=./volumes/searxng/data

# Database catalog name. Must match the value used by your other launcher
# (repo docker/.env uses "guideants") to share the same database/account.
GA_DB_NAME=guideants

GA_DOCUMENTSERVER_IMAGE=ghcr.io/euro-office/documentserver:latest
GA_DOCUMENTSERVER_ENABLED=true
GA_DOCUMENTSERVER_JWT_ENABLED=false

# Local embeddings defaults (compose references these without inline defaults).
GA_EMB_DEFAULT_MODEL_PATH=harrier-oss-v1-0.6b
GA_EMB_AUTO_LOAD_ON_STARTUP=1
GA_EMB_WARMUP_ON_LOAD=1

# Optional: Hugging Face token for model download flows.
# HF_TOKEN=hf_xxxxx
