# syntax=docker/dockerfile:1.7-labs

# =============================================================================
# ROCm-only stable-diffusion.cpp builder
# =============================================================================
ARG SDCPP_REF=master
ARG SD_AMDGPU_TARGETS="gfx1030;gfx1100;gfx1101;gfx1102;gfx1200;gfx1201"
ARG GA_DEPS_ROCM_IMAGE=deps-rocm
ARG GA_UBUNTU_MIRROR_URL=http://archive.ubuntu.com/ubuntu
ARG PYTHON311_VERSION=3.11.11

FROM rocm/dev-ubuntu-24.04:latest AS sd-cli-rocm-builder
ARG SDCPP_REF
ARG SD_AMDGPU_TARGETS
ARG GA_UBUNTU_MIRROR_URL
RUN if [ -f /etc/apt/sources.list.d/ubuntu.sources ]; then \
        sed -i \
            -e "s|http://archive.ubuntu.com/ubuntu|${GA_UBUNTU_MIRROR_URL}|g" \
            -e "s|http://security.ubuntu.com/ubuntu|${GA_UBUNTU_MIRROR_URL}|g" \
            /etc/apt/sources.list.d/ubuntu.sources; \
    fi \
    && if [ -f /etc/apt/sources.list ]; then \
        sed -i \
            -e "s|http://archive.ubuntu.com/ubuntu|${GA_UBUNTU_MIRROR_URL}|g" \
            -e "s|http://security.ubuntu.com/ubuntu|${GA_UBUNTU_MIRROR_URL}|g" \
            /etc/apt/sources.list; \
    fi
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends build-essential ca-certificates cmake git hipblas-dev rocblas-dev \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --recursive --depth 1 --shallow-submodules --branch ${SDCPP_REF} https://github.com/leejet/stable-diffusion.cpp /src/stable-diffusion.cpp \
    && cmake -S /src/stable-diffusion.cpp -B /src/stable-diffusion.cpp/build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
        -DCMAKE_EXE_LINKER_FLAGS=-no-pie \
        -DSD_BUILD_EXAMPLES=ON \
        -DBUILD_SHARED_LIBS=OFF \
        -DSD_WEBP=OFF \
        -DSD_WEBM=OFF \
        -DSD_HIPBLAS=ON \
        -DGGML_HIPBLAS=ON \
        "-DAMDGPU_TARGETS=${SD_AMDGPU_TARGETS}" \
    && cmake --build /src/stable-diffusion.cpp/build --config Release -j"$(nproc)" \
    && mkdir -p /out \
    && if [ -f /src/stable-diffusion.cpp/build/bin/sd-cli ]; then cp /src/stable-diffusion.cpp/build/bin/sd-cli /out/sd-cli; \
       elif [ -f /src/stable-diffusion.cpp/build/bin/sd ]; then cp /src/stable-diffusion.cpp/build/bin/sd /out/sd-cli; \
       else echo "sd-cli binary was not produced by stable-diffusion.cpp ROCm build" && exit 1; fi \
    && if [ -f /src/stable-diffusion.cpp/build/bin/sd-server ]; then cp /src/stable-diffusion.cpp/build/bin/sd-server /out/sd-server; \
       else echo "sd-server binary was not produced by stable-diffusion.cpp ROCm build" && exit 1; fi \
    && strip /out/sd-cli /out/sd-server || true

FROM python:${PYTHON311_VERSION}-slim-bookworm AS python311-runtime
ARG PYTHON311_VERSION

FROM ubuntu:24.04 AS script-agent-exec-builder
ARG GA_UBUNTU_MIRROR_URL
RUN if [ -f /etc/apt/sources.list.d/ubuntu.sources ]; then \
        sed -i \
            -e "s|http://archive.ubuntu.com/ubuntu|${GA_UBUNTU_MIRROR_URL}|g" \
            -e "s|http://security.ubuntu.com/ubuntu|${GA_UBUNTU_MIRROR_URL}|g" \
            /etc/apt/sources.list.d/ubuntu.sources; \
    fi
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends gcc libc6-dev \
    && rm -rf /var/lib/apt/lists/*
COPY script-agent-exec/ga-script-exec.c /tmp/ga-script-exec.c
RUN gcc -O2 -Wall -Wextra -o /usr/local/bin/ga-script-exec /tmp/ga-script-exec.c

# =============================================================================
# ROCm backend (runtime base + python deps builder + dependency image)
# =============================================================================
FROM ghcr.io/ggml-org/llama.cpp:server-rocm AS runtime-rocm-base
ARG GA_UBUNTU_MIRROR_URL
ENV DEBIAN_FRONTEND=noninteractive
RUN if [ -f /etc/apt/sources.list.d/ubuntu.sources ]; then \
        sed -i \
            -e "s|http://archive.ubuntu.com/ubuntu|${GA_UBUNTU_MIRROR_URL}|g" \
            -e "s|http://security.ubuntu.com/ubuntu|${GA_UBUNTU_MIRROR_URL}|g" \
            /etc/apt/sources.list.d/ubuntu.sources; \
    fi \
    && if [ -f /etc/apt/sources.list ]; then \
        sed -i \
            -e "s|http://archive.ubuntu.com/ubuntu|${GA_UBUNTU_MIRROR_URL}|g" \
            -e "s|http://security.ubuntu.com/ubuntu|${GA_UBUNTU_MIRROR_URL}|g" \
            /etc/apt/sources.list; \
    fi

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl \
        libbz2-1.0 libffi8 libgdbm6 liblzma5 libncursesw6 \
        libreadline8 libsqlite3-0 libssl3 zlib1g libuuid1 tk \
    && rm -rf /var/lib/apt/lists/*
COPY --from=python311-runtime /usr/local/bin/python3.11 /usr/local/bin/python3.11
COPY --from=python311-runtime /usr/local/bin/pip3.11 /usr/local/bin/pip3.11
COPY --from=python311-runtime /usr/local/lib/python3.11 /usr/local/lib/python3.11
COPY --from=python311-runtime /usr/local/lib/libpython3.11.so.1.0 /usr/local/lib/libpython3.11.so.1.0
COPY --from=python311-runtime /usr/local/include/python3.11 /usr/local/include/python3.11
RUN ln -sf /usr/local/bin/python3.11 /usr/local/bin/python3 \
    && ln -sf /usr/local/bin/pip3.11 /usr/local/bin/pip3 \
    && echo "/usr/local/lib" > /etc/ld.so.conf.d/python311.conf \
    && ldconfig

RUN curl -fsSL https://dot.net/v1/dotnet-install.sh -o /tmp/dotnet-install.sh \
    && chmod +x /tmp/dotnet-install.sh \
    && /tmp/dotnet-install.sh --channel 8.0 --runtime aspnetcore --install-dir /usr/share/dotnet \
    && ln -sf /usr/share/dotnet/dotnet /usr/bin/dotnet \
    && rm /tmp/dotnet-install.sh
ENV DOTNET_ROOT=/usr/share/dotnet

ARG PWSH_VERSION=7.4.7
RUN curl -sSL "https://github.com/PowerShell/PowerShell/releases/download/v${PWSH_VERSION}/powershell-${PWSH_VERSION}-linux-x64.tar.gz" \
        -o /tmp/pwsh.tar.gz \
    && mkdir -p /opt/microsoft/powershell/${PWSH_VERSION} \
    && tar zxf /tmp/pwsh.tar.gz -C /opt/microsoft/powershell/${PWSH_VERSION} \
    && ln -s /opt/microsoft/powershell/${PWSH_VERSION}/pwsh /usr/bin/pwsh \
    && chmod +x /usr/bin/pwsh \
    && rm /tmp/pwsh.tar.gz

ENV VIRTUAL_ENV=/opt/venv
ENV PATH="$VIRTUAL_ENV/bin:$PATH"
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PYTHONUNBUFFERED=1
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
ENV CPLUS_INCLUDE_PATH=/usr/include/gdal
ENV C_INCLUDE_PATH=/usr/include/gdal

FROM runtime-rocm-base AS pydeps-rocm-builder
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential cmake git \
        graphviz graphviz-dev \
        libopenblas-dev liblapack-dev libboost-python-dev \
        gdal-bin libgdal-dev \
        libgeos-dev libproj-dev \
        ffmpeg espeak-ng \
    && rm -rf /var/lib/apt/lists/*

RUN python3.11 -m venv $VIRTUAL_ENV

COPY asr-requirements.txt /tmp/asr-requirements.txt
COPY tts-requirements.txt /tmp/tts-requirements.txt
COPY emb-requirements.txt /tmp/emb-requirements.txt
COPY requirements.txt /tmp/requirements.txt

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip "setuptools<82" wheel \
    && pip install \
        torch==2.11.0 torchaudio==2.11.0 torchvision==0.26.0 \
        --index-url https://download.pytorch.org/whl/cpu \
    && pip install -r /tmp/asr-requirements.txt \
    && pip install -r /tmp/tts-requirements.txt \
    && pip install accelerate==1.12.0 transformers==4.57.6 tokenizers==0.22.2 \
    && pip install -r /tmp/emb-requirements.txt \
    && pip install -r /tmp/requirements.txt \
    && pip uninstall -y jupyterlab-tensorboard-pro basemap basemap-data \
    && pip install tornado==6.5.7 wheel==0.46.2 \
    && pip check \
    && rm -f /tmp/asr-requirements.txt /tmp/tts-requirements.txt /tmp/emb-requirements.txt /tmp/requirements.txt

FROM runtime-rocm-base AS deps-rocm
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends \
        graphviz ffmpeg espeak-ng bash sqlite3 nginx util-linux passwd \
        libopenblas0-pthread liblapack3 \
        gdal-bin libgdal-dev \
        libgeos-dev libproj-dev \
    && rm -rf /var/lib/apt/lists/*

COPY --from=pydeps-rocm-builder /opt/venv /opt/venv
COPY --from=sd-cli-rocm-builder /out/sd-cli /usr/local/bin/sd-cli
COPY --from=sd-cli-rocm-builder /out/sd-server /usr/local/bin/sd-server
RUN chmod +x /usr/local/bin/sd-cli /usr/local/bin/sd-server

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install playwright \
    && playwright install --with-deps chromium

FROM ${GA_DEPS_ROCM_IMAGE} AS final-rocm

ENV SCRIPT_EXECUTION_ADMIN_API_ENABLED=true
ENV SCRIPT_EXECUTION_ADMIN_STATE_DIR=/var/lib/guideants/script-agent-admin
ENV SCRIPT_EXECUTION_SCOPE_STATE_ROOT=/var/lib/guideants/script-agent-admin/scopes

COPY ScriptExecutionAgent/ /app/script-agent/
COPY script-agent-admin/ /opt/guideants/script-agent-admin/
COPY --from=script-agent-exec-builder /usr/local/bin/ga-script-exec /usr/local/bin/ga-script-exec
COPY nginx.conf /etc/nginx/nginx.conf
COPY entrypoint.sh /entrypoint.sh
COPY start-llama.sh /app/start-llama.sh
COPY start-llama-admin.sh /app/start-llama-admin.sh
COPY start-asr.sh /app/start-asr.sh
COPY start-sd.sh /app/start-sd.sh
COPY start-tts.sh /app/start-tts.sh
COPY start-emb.sh /app/start-emb.sh
COPY start-media.sh /app/start-media.sh
COPY router-models.seed.ini /opt/seed/router-models.ini
RUN chmod +x /entrypoint.sh /opt/guideants/script-agent-admin/reconcile.sh /app/start-llama.sh /app/start-llama-admin.sh /app/start-asr.sh /app/start-sd.sh /app/start-tts.sh /app/start-emb.sh /app/start-media.sh

COPY llama-admin-service/ /app/llama-admin-service/
COPY asr-service/ /app/asr-service/
COPY sd-service/ /app/sd-service/
COPY tts-service/ /app/tts-service/
COPY emb-service/ /app/emb-service/
COPY media-service/ /app/media-service/

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -fsS http://localhost/sandbox/health || curl -fsS http://localhost/llama-cpp/health || curl -fsS http://localhost/asr/health || curl -fsS http://localhost/sd/health || curl -fsS http://localhost/tts/health || curl -fsS http://localhost/emb/health || curl -fsS http://localhost/media/health || exit 1

ENTRYPOINT ["/entrypoint.sh"]
