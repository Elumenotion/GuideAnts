# Shared docling-serve environment variables for GuideAnts compose stacks.
# Reference this list when editing docker-compose*.yml docling-serve services.
#
# Defaults align with MarkdownExtraction:MaxFileSizeMB=500 (524288000 bytes).

DOCLING_SERVE_MAX_SYNC_WAIT=600
DOCLING_SERVE_MAX_FILE_SIZE=524288000
DOCLING_SERVE_ENG_LOC_NUM_WORKERS=2
DOCLING_SERVE_ENG_LOC_SHARE_MODELS=false
DOCLING_NUM_THREADS=4
DOCLING_SERVE_LOAD_MODELS_AT_BOOT=true
DOCLING_SERVE_OPTIONS_CACHE_SIZE=2
DOCLING_SERVE_LOG_LEVEL=WARNING
DOCLING_SERVE_LOG_FORMAT=text
# Optional shared secret. Docling v1.21+ crashes if this is set to an empty value —
# only add DOCLING_SERVE_API_KEY to docling-serve (and DocumentIntelligence__DoclingApiKey
# on guideants-webapi-ui) when you have a real key configured.
# DOCLING_SERVE_API_KEY=your-secret-here
DOCLING_SERVE_OTEL_ENABLE_METRICS=true
DOCLING_SERVE_OTEL_ENABLE_TRACES=false
DOCLING_DEBUG_PROFILE_PIPELINE_TIMINGS=false
# CUDA stacks only:
# GA_DOCLING_CUDA_VISIBLE_DEVICES=
# DOCLING_DEVICE=cuda
# Optional pre-downloaded model directory on the host (bind-mount manually in compose when used):
# GA_DOCLING_ARTIFACTS_HOST_PATH=
# DOCLING_SERVE_ARTIFACTS_PATH=/opt/docling-artifacts
