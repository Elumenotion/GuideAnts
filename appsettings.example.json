{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1434;Initial Catalog=guideants-dev;Persist Security Info=False;User ID=sa;Password=replace-with-local-db-password;MultipleActiveResultSets=True;Encrypt=False;TrustServerCertificate=True;Connection Timeout=30;ConnectRetryCount=3;ConnectRetryInterval=5;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.EntityFrameworkCore.Query": "Warning",
      "Microsoft.EntityFrameworkCore.Update": "Warning",
      "Microsoft.EntityFrameworkCore.ChangeTracking": "Warning",
      "Microsoft.IdentityModel.LoggingExtensions.IdentityLoggerAdapter": "Warning",
      "WaterfallApi.Services.NotebookDockerScriptService": "Warning",
      "WaterfallApi.Services.Components.MarkdownExtractionService": "Warning",
      "WaterfallApi.Services.Components.SpeechTranscriptionService": "Warning",
      "AntRunner": "Warning",
      "AntRunner.Chat": "Warning",
      "AntRunner.ToolCalling": "Warning"
    },
    "Console": {
      "IncludeScopes": true,
      "TimestampFormat": "yyyy-MM-dd HH:mm:ss.fff ",
      "LogLevel": {
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Microsoft.EntityFrameworkCore.Query": "Warning"
      }
    }
  },
  "ALLOWED_ORIGINS": "*",
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "common",
    "ClientId": "replace-with-entra-client-id",
    "Audience": "replace-with-entra-client-id",
    "ValidIssuers": []
  },
  "ScriptExecution": {
    "DefaultContainers": {
      "Python": "python-sandbox",
      "PowerShell": "pwsh-sandbox",
      "Bash": "bash-sandbox"
    },
    "TimeoutSeconds": 300,
    "MaxMemoryMB": 1024
  },
  "Docker": {
    "ContainerName": "python-app"
  },
  "NotebookTemplates": {
    "BaseFolderPath": "..\\NotebookTemplates"
  },
  "FileStorage": {
    "Path": "../ContentFiles"
  },
  "AssistantDefinitions": {
    "BaseFolderPath": "..\\AssistantDefinitions"
  },
  "AzureDocumentIntelligence": {
    "Endpoint": "https://your-docintel-resource.cognitiveservices.azure.com/",
    "ApiKey": "replace-with-azure-document-intelligence-api-key",
    "ApiVersion": "2024-11-30",
    "TimeoutSeconds": 300,
    "MaxRetries": 3
  },
  "DocumentIntelligence": {
    "Provider": "azure",
    "LocalDoclingBaseUrl": "http://localhost:5001",
    "TimeoutSeconds": 300
  },
  "AzureSpeechService": {
    "Endpoint": "https://your-speech-resource.cognitiveservices.azure.com/",
    "ApiKey": "replace-with-azure-speech-api-key",
    "Region": "eastus2",
    "TimeoutSeconds": 600,
    "MaxRetries": 3
  },
  "VideoAudioExtraction": {
    "FfmpegPath": "C:\\path\\to\\ffmpeg.exe",
    "TempDirectory": "temp/audio-extraction",
    "AudioFormat": "mp3",
    "AudioQuality": "2",
    "TimeoutSeconds": 1800,
    "MaxFileSizeMB": 2048
  },
  "MarkdownExtraction": {
    "Enabled": true,
    "ProcessingIntervalSeconds": 30,
    "BatchSize": 5,
    "MaxFileSizeMB": 500,
    "SupportedExtensions": [ ".pdf", ".docx", ".xlsx", ".pptx", ".jpg", ".jpeg", ".png", ".bmp", ".tiff", ".heif", ".html", ".mp3", ".wav", ".m4a", ".aac", ".ogg", ".flac", ".wma", ".mp4", ".mov", ".avi", ".webm", ".wmv", ".mkv", ".flv", ".m4v" ]
  },
  "BackgroundJobs": {
    "PollingIntervalSeconds": 10,
    "JobTypes": {
      "Test": {
        "MaxConcurrency": 10,
        "LeaseSeconds": 300
      },
      "ExtractContentVersionMarkdown": {
        "MaxConcurrency": 10,
        "LeaseSeconds": 300
      },
      "ExtractNotebookFileMarkdown": {
        "MaxConcurrency": 10,
        "LeaseSeconds": 300
      },
      "TranscribeContentVersionMarkdown": {
        "MaxConcurrency": 10,
        "LeaseSeconds": 300
      },
      "TranscribeNotebookFileMarkdown": {
        "MaxConcurrency": 10,
        "LeaseSeconds": 300
      },
      "IndexContentMarkdownShadow": {
        "MaxConcurrency": 10,
        "LeaseSeconds": 300
      },
      "IndexNotebookMarkdownShadow": {
        "MaxConcurrency": 10,
        "LeaseSeconds": 300
      },
      "IndexDirectTextFile": {
        "MaxConcurrency": 3,
        "LeaseSeconds": 300
      },
      "SyncNotebook": {
        "MaxConcurrency": 10,
        "LeaseSeconds": 300
      },
      "ExtractAssistantFileMarkdown": {
        "MaxConcurrency": 2,
        "LeaseSeconds": 300
      },
      "IndexAssistantFileMarkdownShadow": {
        "MaxConcurrency": 4,
        "LeaseSeconds": 180
      },
      "StripeDailyOverage": {
        "MaxConcurrency": 1,
        "LeaseSeconds": 600
      },
      "RetentionCleanup": {
        "MaxConcurrency": 2,
        "LeaseSeconds": 900
      }
    }
  },
  "Stripe": {
    "SecretKey": "replace-with-stripe-secret-key",
    "WebhookSecret": "replace-with-stripe-webhook-secret",
    "DashboardBaseUrl": "https://dashboard.stripe.com/test"
  },
  "StripeBilling": {
    "DailyOverageEnabled": true,
    "DailyRunAtUtc": "01:15"
  },
  "AZURE_OPENAI_RESOURCE": "replace-with-azure-openai-resource-name",
  "AZURE_OPENAI_API_KEY": "replace-with-azure-openai-api-key",
  "AZURE_OPENAI_DEPLOYMENT": "gpt-4.1",
  "AZURE_OPENAI_API_VERSION": "2025-04-01-preview",
  "ASSISTANTS_BASE_FOLDER_PATH": "..\\AssistantDefinitions",
  "ANTRUNNER_SERVICES_HOST_URL": "http://localhost:5106/",
  "ASPNETCORE_ENVIRONMENT": "Development",
  "ASPNETCORE_URLS": "http://+:8080",
  "AZURE_CLIENT_ID": "",
  "StorageAccount": {
    "Key": ""
  },
  "AzureOpenAiImages": {
    "Endpoint": "https://your-images-resource.cognitiveservices.azure.com/",
    "ApiKey": "replace-with-azure-openai-images-api-key",
    "Deployment": "your-image-deployment",
    "EditModelDeployment": "your-image-edit-deployment",
    "ApiVersion": "2025-04-01-preview"
  },
  "AzureOpenAiEmbedding": {
    "Endpoint": "https://your-embedding-resource.openai.azure.com/",
    "ApiKey": "replace-with-azure-openai-embedding-api-key",
    "Deployment": "text-embedding-3-small"
  },
  "Postmark": {
    "ApiKey": "replace-with-postmark-api-key",
    "FromEmail": "noreply@example.com",
    "FromName": "GuideAnts Notebooks"
  },
  "PUBLIC_APP_URL": "http://localhost:4173/"
}
