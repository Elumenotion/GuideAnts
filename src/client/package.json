{
  "name": "guideants-notebooks",
  "version": "1.2.25",
  "type": "module",
  "main": "electron/main.js",
  "description": "GuideAnts Notebooks",
  "author": "",
  "license": "ISC",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:analyze": "cross-env ANALYZE=true npm run build",
    "serve": "vite preview",
    "browser:dev": "vite --config vite.config.browser.ts",
    "browser:build": "tsc --project tsconfig.browser.json && vite build --mode development --config vite.config.browser.ts",
    "browser:build:docker": "tsc --project tsconfig.browser.json && vite build --mode docker --config vite.config.browser.ts",
    "browser:analyze": "cross-env ANALYZE=true npm run browser:build",
    "browser:serve": "vite preview --config vite.config.browser.ts",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:build": "npm run build && electron-builder",
    "docker:up": "cd ../server && docker compose up -d",
    "docker:down": "cd ../server && docker compose down",
    "server:rebuild": "cd ../server && pwsh -File ./rebuild_server.ps1",
    "db:reset": "cd ../server && pwsh -File ./reset_dev_env.ps1",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui --api.port 51515",
    "find-orphans": "knip --dependencies --files",
    "find-orphans:prod-deps": "knip --config knip.prod.jsonc --production --dependencies",
    "electron:build:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@lexical/code": "^0.32.1",
    "@lexical/link": "^0.32.1",
    "@lexical/list": "^0.32.1",
    "@lexical/markdown": "^0.32.1",
    "@lexical/react": "^0.32.1",
    "@lexical/rich-text": "^0.32.1",
    "@lexical/selection": "^0.32.1",
    "@lexical/table": "^0.32.1",
    "@lexical/utils": "^0.32.1",
    "@types/node": "^22.15.24",
    "@types/react": "^19.1.6",
    "diff": "^5.1.0",
    "driver.js": "^1.3.6",
    "electron-context-menu": "^4.1.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2",
    "express": "^4.19.2",
    "guideants": "^0.6.13",
    "idb": "^7.1.1",
    "lexical": "^0.32.1",
    "mermaid": "^11.6.0",
    "react": "^19.1.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.1",
    "recharts": "^3.5.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.8.3",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.5.0",
    "@vitest/coverage-v8": "^4.0.10",
    "@vitest/ui": "^4.0.10",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "jsdom": "^24.0.0",
    "knip": "^5.0.0",
    "postcss": "^8.5.3",
    "rollup-plugin-visualizer": "^6.0.5",
    "tailwindcss": "^3.4.1",
    "vite": "^6.3.5",
    "vitest": "^4.0.10"
  },
  "build": {
    "appId": "com.guideants.notebooks",
    "productName": "GuideAnts Notebooks",
    "icon": "public/maskable-icon.png",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/maskable-icon.png"
    ],
    "extraResources": [
      {
        "from": ".env.docker",
        "to": ".env.docker"
      }
    ],
    "artifactName": "GuideAnts-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "generic",
        "url": "https://www.guideants.ai/guideants/"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
