# syntax=docker/dockerfile:1.7-labs

# =============================================================================
# Vulkan stable-diffusion.cpp builder
# =============================================================================
ARG SDCPP_REF=master
ARG AUDIOCPP_REF=release-0.1
ARG GA_DEPS_VULKAN_IMAGE=deps-vulkan
ARG GA_UBUNTU_MIRROR_URL=http://archive.ubuntu.com/ubuntu
ARG PYTHON311_VERSION=3.11.11

FROM ubuntu:24.04 AS sd-cli-vulkan-builder
ARG SDCPP_REF
ARG GA_UBUNTU_MIRROR_URL
RUN if [ -f /etc/apt/sources.list.d/ubuntu.sources ]; then \
        sed -i \
            -e "s|http://archive.ubuntu.com/ubuntu|${GA_UBUNTU_MIRROR_URL}|g" \
            -e "s|http://security.ubuntu.com/ubuntu|${GA_UBUNTU_MIRROR_URL}|g" \
            /etc/apt/sources.list.d/ubuntu.sources; \
    fi \
    && if [ -f /etc/apt/sources.list ]; then \
        sed -i \
            -e "s|http://archive.ubuntu.com/ubuntu|${GA_UBUNTU_MIRROR_URL}|g" \
            -e "s|http://security.ubuntu.com/ubuntu|${GA_UBUNTU_MIRROR_URL}|g" \
            /etc/apt/sources.list; \
    fi
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends software-properties-common \
    && add-apt-repository -y universe \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential ca-certificates cmake git \
        libvulkan-dev glslang-tools glslc spirv-headers \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --recursive --depth 1 --shallow-submodules --branch ${SDCPP_REF} https://github.com/leejet/stable-diffusion.cpp /src/stable-diffusion.cpp \
    && cmake -S /src/stable-diffusion.cpp -B /src/stable-diffusion.cpp/build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
        -DCMAKE_EXE_LINKER_FLAGS=-no-pie \
        -DSD_BUILD_EXAMPLES=ON \
        -DBUILD_SHARED_LIBS=OFF \
        -DSD_WEBP=OFF \
        -DSD_WEBM=OFF \
        -DSD_VULKAN=ON \
        -DGGML_VULKAN=ON \
    && cmake --build /src/stable-diffusion.cpp/build --config Release -j"$(nproc)" \
    && mkdir -p /out \
    && if [ -f /src/stable-diffusion.cpp/build/bin/sd-cli ]; then cp /src/stable-diffusion.cpp/build/bin/sd-cli /out/sd-cli; \
       elif [ -f /src/stable-diffusion.cpp/build/bin/sd ]; then cp /src/stable-diffusion.cpp/build/bin/sd /out/sd-cli; \
       else echo "sd-cli binary was not produced by stable-diffusion.cpp Vulkan build" && exit 1; fi \
    && if [ -f /src/stable-diffusion.cpp/build/bin/sd-server ]; then cp /src/stable-diffusion.cpp/build/bin/sd-server /out/sd-server; \
       else echo "sd-server binary was not produced by stable-diffusion.cpp Vulkan build" && exit 1; fi \
    && strip /out/sd-cli /out/sd-server || true

FROM ubuntu:24.04 AS audiocpp-vulkan-builder
ARG AUDIOCPP_REF
ARG GA_UBUNTU_MIRROR_URL
RUN if [ -f /etc/apt/sources.list.d/ubuntu.sources ]; then \
        sed -i \
            -e "s|http://archive.ubuntu.com/ubuntu|${GA_UBUNTU_MIRROR_URL}|g" \
            -e "s|http://security.ubuntu.com/ubuntu|${GA_UBUNTU_MIRROR_URL}|g" \
            /etc/apt/sources.list.d/ubuntu.sources; \
    fi \
    && if [ -f /etc/apt/sources.list ]; then \
        sed -i \
            -e "s|http://archive.ubuntu.com/ubuntu|${GA_UBUNTU_MIRROR_URL}|g" \
            -e "s|http://security.ubuntu.com/ubuntu|${GA_UBUNTU_MIRROR_URL}|g" \
            /etc/apt/sources.list; \
    fi
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends software-properties-common \
    && add-apt-repository -y universe \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential ca-certificates cmake git \
        libvulkan-dev glslang-tools glslc spirv-headers \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --recursive --depth 1 --shallow-submodules --branch ${AUDIOCPP_REF} https://github.com/0xShug0/audio.cpp /src/audio.cpp \
    && cmake -S /src/audio.cpp -B /src/audio.cpp/build \
        -DCMAKE_BUILD_TYPE=Release \
        -DENGINE_ENABLE_CUDA=OFF \
        -DENGINE_ENABLE_VULKAN=ON \
        -DGGML_VULKAN=ON \
        -DENGINE_ENABLE_NATIVE_CPU=OFF \
        -DENGINE_BUILD_EXAMPLES=OFF \
        -DENGINE_BUILD_TESTS=OFF \
        -DENGINE_BUILD_WARMBENCH=OFF \
    && cmake --build /src/audio.cpp/build --target audiocpp_server --config Release -j"$(nproc)" \
    && mkdir -p /out \
    && if [ -f /src/audio.cpp/build/bin/audiocpp_server ]; then cp /src/audio.cpp/build/bin/audiocpp_server /out/audiocpp_server; \
       else echo "audiocpp_server binary was not produced by audio.cpp Vulkan build" && exit 1; fi \
    && (strip /out/audiocpp_server || true)

# =============================================================================
# Mesa "dzn" (Dozen) Vulkan-on-D3D12 driver builder
#
# Ubuntu's mesa-vulkan-drivers ships RADV/ANV/NVK/llvmpipe but NOT dzn. dzn is
# the only GPU Vulkan path inside a WSL2 / Docker Desktop container:
#   Vulkan -> dzn -> D3D12 -> /dev/dxg -> the Windows GPU driver.
# Build just that one driver from the Mesa source matching the runtime's Mesa
# (Ubuntu 26.04 = 26.0.x) and stage the ICD + its two runtime libs. Consumed at
# runtime by docker-compose.vulkan.yml, which points VK_DRIVER_FILES at
# dzn_icd.json and bind-mounts /usr/lib/wsl for libd3d12core.so / libdxcore.so.
#
# microsoft-experimental is Mesa's meson value for dzn; DirectX-Headers is
# pulled automatically via Mesa's meson wrap. MESA_DZN_REF tracks the runtime.
FROM ubuntu:26.04 AS dzn-vulkan-builder
ARG GA_UBUNTU_MIRROR_URL
ARG MESA_DZN_REF=mesa-26.0.3
RUN if [ -f /etc/apt/sources.list.d/ubuntu.sources ]; then \
        sed -i \
            -e "s|http://archive.ubuntu.com/ubuntu|${GA_UBUNTU_MIRROR_URL}|g" \
            -e "s|http://security.ubuntu.com/ubuntu|${GA_UBUNTU_MIRROR_URL}|g" \
            /etc/apt/sources.list.d/ubuntu.sources; \
    fi \
    && if [ -f /etc/apt/sources.list ]; then \
        sed -i \
            -e "s|http://archive.ubuntu.com/ubuntu|${GA_UBUNTU_MIRROR_URL}|g" \
            -e "s|http://security.ubuntu.com/ubuntu|${GA_UBUNTU_MIRROR_URL}|g" \
            /etc/apt/sources.list; \
    fi
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential meson ninja-build pkg-config \
        python3-mako python3-yaml python3-setuptools \
        bison flex \
        libvulkan-dev libdrm-dev libexpat1-dev zlib1g-dev libzstd-dev \
        glslang-tools \
        git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch ${MESA_DZN_REF} \
        https://gitlab.freedesktop.org/mesa/mesa.git /src/mesa \
    && meson setup /src/mesa/build /src/mesa \
        --prefix=/usr \
        --libdir=lib/x86_64-linux-gnu \
        --buildtype=release \
        -Dvulkan-drivers=microsoft-experimental \
        -Dgallium-drivers= \
        -Dplatforms= \
        -Dglx=disabled \
        -Degl=disabled \
        -Dgbm=disabled \
        -Dllvm=disabled \
    && ninja -C /src/mesa/build \
    && DESTDIR=/stage ninja -C /src/mesa/build install \
    && mkdir -p /dzn-out/lib /dzn-out/icd \
    && cp /stage/usr/lib/x86_64-linux-gnu/libvulkan_dzn.so /dzn-out/lib/ \
    && cp /stage/usr/lib/x86_64-linux-gnu/libspirv_to_dxil.so /dzn-out/lib/ 2>/dev/null || true \
    && cp /stage/usr/share/vulkan/icd.d/dzn_icd*.json /dzn-out/icd/dzn_icd.json \
    && echo "=== staged dzn artifacts ===" && ls -l /dzn-out/lib /dzn-out/icd && cat /dzn-out/icd/dzn_icd.json

FROM python:${PYTHON311_VERSION}-slim-bookworm AS python311-runtime
ARG PYTHON311_VERSION

FROM ubuntu:24.04 AS script-agent-exec-builder
ARG GA_UBUNTU_MIRROR_URL
RUN if [ -f /etc/apt/sources.list.d/ubuntu.sources ]; then \
        sed -i \
            -e "s|http://archive.ubuntu.com/ubuntu|${GA_UBUNTU_MIRROR_URL}|g" \
            -e "s|http://security.ubuntu.com/ubuntu|${GA_UBUNTU_MIRROR_URL}|g" \
            /etc/apt/sources.list.d/ubuntu.sources; \
    fi
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends gcc libc6-dev \
    && rm -rf /var/lib/apt/lists/*
COPY script-agent-exec/ga-script-exec.c /tmp/ga-script-exec.c
RUN gcc -O2 -Wall -Wextra -o /usr/local/bin/ga-script-exec /tmp/ga-script-exec.c

# =============================================================================
# Vulkan backend (runtime base + python deps builder + dependency image)
# =============================================================================
FROM ghcr.io/ggml-org/llama.cpp:server-vulkan AS runtime-vulkan-base
ARG GA_UBUNTU_MIRROR_URL
ENV DEBIAN_FRONTEND=noninteractive
RUN if [ -f /etc/apt/sources.list.d/ubuntu.sources ]; then \
        sed -i \
            -e "s|http://archive.ubuntu.com/ubuntu|${GA_UBUNTU_MIRROR_URL}|g" \
            -e "s|http://security.ubuntu.com/ubuntu|${GA_UBUNTU_MIRROR_URL}|g" \
            /etc/apt/sources.list.d/ubuntu.sources; \
    fi \
    && if [ -f /etc/apt/sources.list ]; then \
        sed -i \
            -e "s|http://archive.ubuntu.com/ubuntu|${GA_UBUNTU_MIRROR_URL}|g" \
            -e "s|http://security.ubuntu.com/ubuntu|${GA_UBUNTU_MIRROR_URL}|g" \
            /etc/apt/sources.list; \
    fi

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl \
        libbz2-1.0 libffi8 libgdbm6 liblzma5 libncursesw6 \
        libreadline8 libsqlite3-0 libssl3 zlib1g libuuid1 tk \
        mesa-vulkan-drivers \
        libglvnd0 libgl1 libglx0 libegl1 libgles2 \
        vulkan-tools \
    && rm -rf /var/lib/apt/lists/*
COPY --from=python311-runtime /usr/local/bin/python3.11 /usr/local/bin/python3.11
COPY --from=python311-runtime /usr/local/bin/pip3.11 /usr/local/bin/pip3.11
COPY --from=python311-runtime /usr/local/lib/python3.11 /usr/local/lib/python3.11
COPY --from=python311-runtime /usr/local/lib/libpython3.11.so.1.0 /usr/local/lib/libpython3.11.so.1.0
COPY --from=python311-runtime /usr/local/include/python3.11 /usr/local/include/python3.11
RUN ln -sf /usr/local/bin/python3.11 /usr/local/bin/python3 \
    && ln -sf /usr/local/bin/pip3.11 /usr/local/bin/pip3 \
    && echo "/usr/local/lib" > /etc/ld.so.conf.d/python311.conf \
    && ldconfig

RUN curl -fsSL https://dot.net/v1/dotnet-install.sh -o /tmp/dotnet-install.sh \
    && chmod +x /tmp/dotnet-install.sh \
    && /tmp/dotnet-install.sh --channel 8.0 --runtime aspnetcore --install-dir /usr/share/dotnet \
    && ln -sf /usr/share/dotnet/dotnet /usr/bin/dotnet \
    && rm /tmp/dotnet-install.sh
ENV DOTNET_ROOT=/usr/share/dotnet

ARG PWSH_VERSION=7.4.7
RUN curl -sSL "https://github.com/PowerShell/PowerShell/releases/download/v${PWSH_VERSION}/powershell-${PWSH_VERSION}-linux-x64.tar.gz" \
        -o /tmp/pwsh.tar.gz \
    && mkdir -p /opt/microsoft/powershell/${PWSH_VERSION} \
    && tar zxf /tmp/pwsh.tar.gz -C /opt/microsoft/powershell/${PWSH_VERSION} \
    && ln -s /opt/microsoft/powershell/${PWSH_VERSION}/pwsh /usr/bin/pwsh \
    && chmod +x /usr/bin/pwsh \
    && rm /tmp/pwsh.tar.gz

ARG NODE_MAJOR=22
RUN curl -fsSL https://deb.nodesource.com/setup_${NODE_MAJOR}.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && node --version \
    && npx --version

ENV VIRTUAL_ENV=/opt/venv
ENV PATH="$VIRTUAL_ENV/bin:$PATH"
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PYTHONUNBUFFERED=1
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
ENV CPLUS_INCLUDE_PATH=/usr/include/gdal
ENV C_INCLUDE_PATH=/usr/include/gdal

FROM runtime-vulkan-base AS pydeps-vulkan-builder
ENV CFLAGS="-Wno-error=incompatible-pointer-types"
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential cmake git pkg-config \
        graphviz graphviz-dev \
        libopenblas-dev liblapack-dev libboost-python-dev \
        gdal-bin libgdal-dev \
        libgeos-dev libproj-dev \
        ffmpeg espeak-ng \
    && rm -rf /var/lib/apt/lists/*

RUN python3.11 -m venv $VIRTUAL_ENV

COPY emb-requirements.txt /tmp/emb-requirements.txt
COPY asr-requirements.txt /tmp/asr-requirements.txt
COPY tts-requirements.txt /tmp/tts-requirements.txt
COPY requirements.txt /tmp/requirements.txt

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip "setuptools<82" wheel \
    && pip install -r /tmp/emb-requirements.txt \
    && pip install -r /tmp/asr-requirements.txt \
    && pip install -r /tmp/tts-requirements.txt \
    && pip install -r /tmp/requirements.txt \
    && pip uninstall -y jupyterlab-tensorboard-pro basemap basemap-data \
    && pip install tornado==6.5.7 wheel==0.46.2 \
    && pip check \
    && rm -f /tmp/emb-requirements.txt /tmp/asr-requirements.txt /tmp/tts-requirements.txt /tmp/requirements.txt

FROM runtime-vulkan-base AS deps-vulkan
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends \
        graphviz ffmpeg espeak-ng bash sqlite3 nginx util-linux passwd \
        libopenblas0-pthread liblapack3 \
        gdal-bin libgdal-dev \
        libgeos-dev libproj-dev \
    && rm -rf /var/lib/apt/lists/*

COPY --from=pydeps-vulkan-builder /opt/venv /opt/venv
COPY --from=sd-cli-vulkan-builder /out/sd-cli /usr/local/bin/sd-cli
COPY --from=sd-cli-vulkan-builder /out/sd-server /usr/local/bin/sd-server
COPY --from=audiocpp-vulkan-builder /out/audiocpp_server /usr/local/bin/audiocpp_server
RUN chmod +x /usr/local/bin/sd-cli /usr/local/bin/sd-server /usr/local/bin/audiocpp_server

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install playwright \
    && cp /etc/os-release /etc/os-release.bak \
    && sed -i 's/26\.04/24.04/g; s/resolute/noble/g' /etc/os-release \
    && playwright install --with-deps chromium \
    && mv /etc/os-release.bak /etc/os-release

FROM ${GA_DEPS_VULKAN_IMAGE} AS final-vulkan

# The server-vulkan base (Ubuntu 26.04) ships no 'render' group, which the
# compose file references via group_add for /dev/dri access. Create both so
# group_add resolves on every host (the container runs as root with
# CAP_DAC_OVERRIDE, so device permission works regardless of the GID).
RUN groupadd -f video && groupadd -f render

# Mesa dzn (Vulkan-on-D3D12) for WSL2 / Docker Desktop GPU Vulkan. Not in
# Ubuntu's mesa-vulkan-drivers, so it's built in dzn-vulkan-builder above. Lives
# in the final stage (not deps) so an ordinary --backend vulkan build picks it
# up without a full --rebuild-base; BuildKit caches the Mesa compile across
# incremental builds. ldconfig so libvulkan_dzn.so finds libspirv_to_dxil.so;
# the WSL D3D12 libs come at runtime from the docker-compose.vulkan.yml
# bind mount (/usr/lib/wsl -> libd3d12core.so, libdxcore.so).
COPY --from=dzn-vulkan-builder /dzn-out/lib/ /usr/lib/x86_64-linux-gnu/
COPY --from=dzn-vulkan-builder /dzn-out/icd/dzn_icd.json /usr/share/vulkan/icd.d/dzn_icd.json
RUN ldconfig

ENV SCRIPT_EXECUTION_ADMIN_API_ENABLED=true
ENV SCRIPT_EXECUTION_ADMIN_STATE_DIR=/var/lib/guideants/script-agent-admin
ENV SCRIPT_EXECUTION_SCOPE_STATE_ROOT=/var/lib/guideants/script-agent-admin/scopes

COPY ScriptExecutionAgent/ /app/script-agent/
COPY script-agent-admin/ /opt/guideants/script-agent-admin/
COPY --from=script-agent-exec-builder /usr/local/bin/ga-script-exec /usr/local/bin/ga-script-exec
COPY nginx.conf /etc/nginx/nginx.conf
COPY entrypoint.sh /entrypoint.sh
COPY start-llama.sh /app/start-llama.sh
COPY start-ga-admin.sh /app/start-ga-admin.sh
COPY start-asr.sh /app/start-asr.sh
COPY start-tts.sh /app/start-tts.sh
COPY start-emb.sh /app/start-emb.sh
COPY start-media.sh /app/start-media.sh
COPY router-models.seed.ini /opt/seed/router-models.ini
RUN chmod +x /entrypoint.sh /opt/guideants/script-agent-admin/reconcile.sh /app/start-llama.sh /app/start-ga-admin.sh /app/start-asr.sh /app/start-tts.sh /app/start-emb.sh /app/start-media.sh

COPY admin-service/ /app/admin-service/

COPY llama-admin-service/ /app/llama-admin-service/
COPY asr-service/ /app/asr-service/
COPY sd-service/ /app/sd-service/
COPY tts-service/ /app/tts-service/
COPY voice-pack/ /opt/guideants/voice-pack/
COPY scripts/check-voice-pack-attribution.py /opt/guideants/scripts/check-voice-pack-attribution.py
RUN python3 /opt/guideants/scripts/check-voice-pack-attribution.py /opt/guideants/voice-pack
COPY emb-service/ /app/emb-service/
COPY media-service/ /app/media-service/

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -fsS http://localhost/sandbox/health || curl -fsS http://localhost/llama-cpp/health || curl -fsS http://localhost/asr/health || curl -fsS http://localhost/sd/health || curl -fsS http://localhost/tts/health || curl -fsS http://localhost/emb/health || curl -fsS http://localhost/media/health || exit 1

ENTRYPOINT ["/entrypoint.sh"]
