{
  "schemaVersion": 1,
  "profileId": "huggingface",
  "displayName": "Hugging Face",
  "settingsValues": {
    "HuggingFace": {
      "Token": "{{huggingface-token}}",
      "RouterBaseUrl": "https://router.huggingface.co/v1"
    }
  },
  "connectionDefinitions": {
    "sectionName": "HuggingFace",
    "requiredFields": [
      "Token"
    ]
  },
  "modelDefinitions": [
    {
      "modelId": "zai-org/GLM-5.2",
      "displayName": "zai-org/GLM-5.2",
      "provider": "hf-inference-chat",
      "isActive": true
    }
  ],
  "serviceDefaults": [
    {
      "serviceId": "Embeddings",
      "providerId": "Embeddings.HuggingFace.Inference",
      "modelId": "microsoft/harrier-oss-v1-0.6b",
