# Copy to comfyui-video-local.runtime.env and adjust paths/tokens for your host.
# Host GPU layout (this machine): index 0 = RTX 4090, index 1 = RTX 5090.
# Pin ComfyUI generation to the 5090; run CorridorKey on cuda:0 (4090) in the V2V pipeline.
GA_CONTENT_FILES_HOST_PATH=D:/repos/GuideAnts-infinitetalk-comfyui/tests/runtime/content-files
GA_SCRIPT_AGENT_TOKEN=local-script-agent-test-token
GA_SCRIPT_AGENT_ADMIN_TOKEN=local-script-agent-test-token
GA_COMFYUI_VIDEO_ADMIN_TOKEN=local-video-admin-test-token
GA_COMFYUI_VIDEO_CUDA_VISIBLE_DEVICES=1
