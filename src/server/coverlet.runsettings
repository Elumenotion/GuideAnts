<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Exclude>
            [*.Tests]*
            [*Tests]*
            [testhost]*
          </Exclude>
          <ModulePathExclude>.*Tests\.dll$</ModulePathExclude>
          <Format>cobertura</Format>
          <ExcludeByAttribute>ObsoleteAttribute,GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
          <ExcludeByFile>
            **/Migrations/**,
            **/GuideAntsApi/Models/**,
            **/GuideAntsApi.DataModel/Models/**,
            **/AntRunner.Chat.Abstractions/**,
            **/AntRunner.Chat.*/**/*Request.cs,
            **/AntRunner.Chat.*/**/*Response.cs,
            **/AntRunner.Chat.*/**/*Choice.cs,
            **/AntRunner.Chat.*/**/*Delta.cs,
            **/AntRunner.Chat.*/**/*Part.cs,
            **/AntRunner.Chat.*/**/*Content.cs,
            **/AntRunner.Chat.*/**/*Usage*.cs,
            **/AntRunner.Chat.*/**/*Config.cs,
            **/AntRunner.Chat.*/**/*Metadata.cs,
            **/ApplicationDbContextDesignTimeFactory.cs,
            **/GuideAntsApi/Resources/**,
            **/ScriptExecutionAgent/**,
            **/GuideAntsApi/Services/Components/Google*.cs,
            **/GuideAntsApi/Services/Components/HuggingFaceAsr*.cs,
            **/GuideAntsApi/Services/Components/OpenRouter*.cs,
            **/GuideAntsApi/Services/HuggingFace/HuggingFaceRepositoryFile.cs,
            **/GuideAntsApi/Services/Auth/ToolOAuthAuthorizeUrlResult.cs,
            **/GuideAntsApi/Services/Auth/ToolOAuthStatus.cs,
            **/AntRunner.Chat/**/*EventArgs.cs,
            **/AntRunner.Chat/**/ChatConversationException.cs,
            **/AntRunner.Chat/**/EnvironmentSettings.cs,
            **/AntRunner.Chat/**/ChatUsage.cs,
            **/AntRunner.Chat/ThreadRun.cs,
            **/AntRunner.Chat/Conversation.cs,
            **/AntRunner.Chat/ChatRunnerUtils.cs,
            **/AntRunner.Chat/AntLoader.cs,
            **/AntRunner.Chat/AgentInvocationTracker.cs,
            **/AntRunner.Chat.*/**/*ChatClient.cs,
            **/AntRunner.Chat.*/**/OpenAiResponsesClient.cs,
            **/AntRunner.ToolCalling/**/ToolCaller.cs,
            **/AntRunner.ToolCalling/**/OAuthHelper.cs,
            **/AntRunner.ToolCalling/**/CodeExecutionSchemaGenerator.cs,
            **/AntRunner.ToolCalling/**/CrewBridgeSchemaGenerator.cs,
            **/AntRunner.ToolCalling/**/DriveTools.cs,
            **/GuideAntsApi.BackgroundJobs/Services/Search/HybridSearcher.cs,
            **/AntRunner.ToolCalling/AssistantDefinitions/**,
            **/AntRunner.ToolCalling/HttpClient/HttpClientUtility.cs,
            **/GuideAntsApi/Exceptions/**,
            **/GuideAnts.Usage/*Factory.cs,
            **/GuideAntsApi/Extensions/LoggingExtensions.cs,
            **/GuideAntsApi/Configuration/BearerSecurityRequirementsOperationFilter.cs,
            **/GuideAntsApi/Services/Conversations/ConversationSubscribers.cs,
            **/GuideAntsApi/Services/Conversations/UserSubscription.cs,
            **/GuideAntsApi/Services/Conversations/PublishedConversationService.cs,
            **/GuideAntsApi/Services/LlamaCpp/LlamaAdminRouterEntryDto.cs,
            **/GuideAntsApi/Services/PublishedGuides/PublishedGuideCostLimitResult.cs,
            **/GuideAntsApi/Services/Auth/ToolOAuthReconnectRequiredException.cs,
            **/GuideAntsApi/Services/Auth/ToolOAuthStatus.cs,
            **/GuideAntsApi/Services/Components/NotebookCopyService.cs,
            **/GuideAntsApi/Services/Components/SemiStructuredDataService.cs,
            **/GuideAntsApi/Services/HuggingFace/HuggingFaceRepositoryBrowser.cs,
            **/GuideAntsApi/Services/SearXngBrowserRenderingClient.cs,
            **/GuideAntsApi/Services/Conversations/Agent.cs,
            **/GuideAntsApi/Services/Conversations/AssistantToolWrappers.cs,
            **/GuideAntsApi/Services/Conversations/ConversationBroadcastHub.cs,
            **/GuideAntsApi/Services/Conversations/ConversationManager.cs,
            **/GuideAntsApi/Services/Auth/PublishedGuideAuthService.cs,
            **/GuideAntsApi/Services/PodcastTools.cs,
            **/GuideAntsApi/Utils/MarkdownUrlConverter.cs,
            **/GuideAntsApi/Services/NotebookDockerScriptService.cs,
            **/AntRunner.ToolCalling/AssistantDefinitions/Storage/**,
            **/GuideAntsApi.BackgroundJobs/Services/Embeddings/OpenAiEmbeddingService.cs,
            **/GuideAntsApi.BackgroundJobs/Services/Embeddings/OpenRouterEmbeddingService.cs,
            **/GuideAntsApi.BackgroundJobs/Services/AzureDocumentIntelligenceExtractor.cs,
            **/GuideAntsApi.BackgroundJobs/Services/DoclingServeDocumentIntelligenceExtractor.cs,
            **/GuideAntsApi.BackgroundJobs/Jobs/ExtractNotebookFileMarkdownHandler.cs,
            **/GuideAntsApi.BackgroundJobs/Jobs/TranscribeNotebookFileMarkdownHandler.cs,
            **/GuideAntsApi.BackgroundJobs/Jobs/RetentionCleanupHandler.cs,
            **/GuideAntsApi.BackgroundJobs/Jobs/ExtractContentVersionMarkdownHandler.cs,
            **/GuideAnts.Usage/UsageRecorderFactory.cs,
            **/GuideAnts.Usage/AgentInvocationRecorderFactory.cs,
            **/GuideAntsApi/Services/Guides/GuideExportImportService.cs,
            **/GuideAntsApi/Services/Guides/GuideUsageService.cs,
            **/GuideAntsApi/Services/Conversations/ContextOptionsService.cs,
            **/GuideAntsApi/Services/Auth/SlidingSessionRenewal.cs,
            **/GuideAntsApi/Services/Components/NotebookFileChangeReporter.cs,
            **/GuideAntsApi/Services/LlamaCpp/LocalModelOnboarding/LocalModelOnboardingValidator.cs,
            **/GuideAntsApi/Configuration/UiApplicationBuilderExtensions.cs,
            **/GuideAntsApi/Services/Auth/ToolOAuthService.cs,
            **/GuideAntsApi.BackgroundJobs/Jobs/TranscribeContentVersionMarkdownHandler.cs,
            **/GuideAntsApi.BackgroundJobs/Services/DoclingConversionLimiter.cs,
            **/GuideAntsApi.BackgroundJobs/Services/DocumentIntelligenceService.cs,
            **/GuideAntsApi/Services/Conversations/ConversationService.cs,
            **/GuideAntsApi/Services/Guides/GuidesService.cs,
            **/GuideAntsApi/Services/StoragePathResolver.cs,
            **/GuideAntsApi/Services/Core/ProjectService.cs,
            **/HtmlAgilityPackExtensions/**
          </ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
